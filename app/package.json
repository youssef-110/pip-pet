{
  "name": "pip-pet",
  "version": "1.0.0",
  "description": "A tiny desk pet that watches your Claude Code sessions",
  "author": "Pip",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.js",
    "icon": "node make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.pip.deskpet",
    "productName": "Pip",
    "files": [
      "main.js",
      "preload.js",
      "sessions.js",
      "hooks.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Pip-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
